PORT=3000
# Copy your Node.js driver connection string from Atlas.
# Replace all placeholders, and include /task_api_demo before the query string.
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>/task_api_demo?retryWrites=true&w=majority"
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=15m
FRONTEND_URL=http://localhost:5173
# Set false to reproduce the browser CORS error.
CORS_ENABLED=true
